+def set_self_canonical(html: str, url: str) -> str:
+    """Force the single canonical (and its og:url twin) to this page's own URL.
+
+    English pages are rewritten in place and never pass through rewrite_head, so
+    whatever canonical the source file happened to carry survives to the deploy.
+    A previous article build stamped every article's canonical with the
+    matter-tracker URL; without this pass seven articles would ask Google to
+    treat them as duplicates of one other page.
+    """
+    html = re.sub(r'(<link rel="canonical" href=")[^"]*(")',
+                  lambda m: m.group(1) + url + m.group(2), html, count=1)
+    html = re.sub(r'(<meta property="og:url" content=")[^"]*(")',
+                  lambda m: m.group(1) + url + m.group(2), html, count=1)
+    # The JSON-LD block carries the page URL too. On the article pages it was
+    # stamped with the matter-tracker URL by the article build, so schema.org
+    # consumers were told eight different pages are the same page.
+    html = re.sub(r'("url":\s*")[^"]*(")',
+                  lambda m: m.group(1) + url + m.group(2), html, count=1)
     return html
 
 
+def rotate_origins() -> int:
+    """Rewrite every stale origin in the published files to ORIGIN.
+
+    Canonicals, og:url, JSON-LD url/logo/@id, hreflang, the `back=` parameter on
+    the Sign-in links, robots.txt's Sitemap line, llms.txt and the .well-known
+    files all embed an absolute origin. Several of them are hand-maintained and
+    no template touches them, so a build-time rotation is the only way the
+    published tree can be guaranteed consistent after a host swap.
+    """
+    targets = [ROOT / "robots.txt", ROOT / "llms.txt", ROOT / "sitemap.xml", ROOT / "site.webmanifest"]
+    for folder in ("it", "ru", "assets", ".well-known"):
+        d = ROOT / folder
+        if d.is_dir():
+            targets += [p for p in d.rglob("*") if p.is_file() and p.suffix in TEXT_SUFFIXES]
+    targets += [p for p in ROOT.glob("*.html")]
+    targets += [p for p in ROOT.glob("*.js")]
+
+    changed = 0
+    for p in targets:
+        if not p.is_file() or p.suffix not in TEXT_SUFFIXES:
+            continue
+        text = p.read_text(encoding="utf-8", errors="replace")
+        new = text
+        for old in OLD_ORIGINS:
+            if old in new:
+                new = new.replace(old, ORIGIN)
+        if new != text:
+            p.write_text(new, encoding="utf-8")
+            changed += 1
+    return changed
+
+
+def verify_no_origin_drift() -> None:
+    """Refuse to publish a tree that points anywhere but ORIGIN."""
+    offenders = {}
+    for p in list(ROOT.glob("*.html")) + list((ROOT / "it").glob("*.html")) + list((ROOT / "ru").glob("*.html")):
+        text = p.read_text(encoding="utf-8", errors="replace")
+        hits = {old: text.count(old) for old in OLD_ORIGINS if old in text}
+        if hits:
+            offenders[str(p.relative_to(ROOT))] = hits
+    if offenders:
+        raise SystemExit("ABORT: pages still point at a retired origin:\n" + json.dumps(offenders, indent=2))
+
